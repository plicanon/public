{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/plicanon-registry-v4.5.json",
  "title": "PliCanon CTS URN Registry v4.1 Draft",
  "type": "object",
  "required": [
    "registry",
    "textgroups",
    "works",
    "versions",
    "exemplars",
    "sources",
    "languages",
    "translators",
    "citation_models",
    "classification_schemes",
    "relationship_types",
    "collections",
    "alignment_sets",
    "witness_locations",
    "identifier_examples",
    "legacy_migration",
    "identity_decisions",
    "legacy_aliases"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "registry": {
      "type": "object",
      "required": [
        "namespace",
        "profile_version",
        "status",
        "design_model",
        "component_policy",
        "identity_parameters",
        "token_policy",
        "minting_policy",
        "release_gates",
        "decision_tiers",
        "deferred_decisions",
        "gate_a_record",
        "gate_b_record",
        "gate_c_record",
        "namespace_authority"
      ],
      "properties": {
        "namespace": {
          "const": "plicanon"
        },
        "profile_version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "design_model": {
          "type": "string"
        },
        "namespace_authority_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "migration_note": {
          "type": "string"
        },
        "component_policy": {
          "type": "object"
        },
        "namespace_authority_uri_status": {
          "type": "string",
          "enum": [
            "not_assigned",
            "decision_required_before_public_minting",
            "assigned_reviewed"
          ]
        },
        "namespace_authority_policy": {
          "type": "object",
          "required": [
            "cts_namespace_token",
            "token_status",
            "authority_uri",
            "authority_uri_status",
            "resolver_endpoints"
          ],
          "properties": {
            "cts_namespace_token": {
              "const": "plicanon"
            },
            "token_status": {
              "type": "string"
            },
            "authority_uri": {
              "type": [
                "string",
                "null"
              ]
            },
            "authority_uri_status": {
              "type": "string"
            },
            "requirement": {
              "type": "string"
            },
            "resolver_endpoints": {
              "type": "string"
            },
            "short_token_candidate": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "recension_identity_policy": {
          "type": "object",
          "required": [
            "classification_only_difference",
            "shared_model_test",
            "textual_difference_with_shared_reference_model",
            "separate_work_threshold",
            "uncertainty",
            "identity_stability",
            "decision_record_required"
          ],
          "additionalProperties": true
        },
        "resolver_fallback_policy": {
          "type": "object",
          "required": [
            "silent_fallback",
            "permitted_fallback"
          ],
          "additionalProperties": true
        },
        "identity_parameters": {
          "type": "object",
          "required": [
            "shared_model_max_unresolved_fraction",
            "status"
          ],
          "properties": {
            "shared_model_max_unresolved_fraction": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "status": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "token_policy": {
          "type": "object"
        },
        "minting_policy": {
          "type": "object",
          "required": [
            "states",
            "eligibility"
          ],
          "properties": {
            "states": {
              "type": "array",
              "items": {
                "enum": [
                  "blocked",
                  "candidate",
                  "held_uncertain",
                  "approved_for_minting",
                  "minted"
                ]
              }
            },
            "eligibility": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "release_gates": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "status",
              "depends_on"
            ],
            "properties": {
              "id": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "label": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "open",
                  "closed"
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D"
                  ]
                }
              },
              "closed_on": {
                "type": "string",
                "format": "date"
              },
              "decided_by": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "closed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "closed_on",
                    "decided_by",
                    "basis"
                  ]
                }
              }
            ]
          }
        },
        "decision_tiers": {
          "type": "object",
          "required": [
            "tier_1_routine",
            "tier_2_structural",
            "escalation",
            "status"
          ]
        },
        "deferred_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "topic",
              "decision",
              "status"
            ]
          }
        },
        "gate_a_record": {
          "type": "object",
          "required": [
            "decided_on",
            "basis_file",
            "decisions"
          ]
        },
        "gate_b_record": {
          "type": "object",
          "required": [
            "status",
            "answers",
            "b1"
          ],
          "properties": {
            "status": {
              "enum": [
                "open",
                "closed"
              ]
            },
            "b1": {
              "type": "object",
              "required": [
                "status",
                "declared",
                "findings",
                "missing",
                "urls_seen"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "open",
                    "closed"
                  ]
                },
                "urls_seen": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "gate_c_record": {
          "type": "object",
          "required": [
            "decided_on",
            "result",
            "statement"
          ],
          "properties": {
            "result": {
              "enum": [
                "none_known_published",
                "published_urns_recorded"
              ]
            }
          }
        },
        "namespace_authority": {
          "type": "object",
          "required": [
            "authority_uri",
            "authority_uri_kind",
            "steward",
            "resolution_mechanism",
            "succession",
            "fallback_endpoint",
            "catalog_pinning"
          ],
          "properties": {
            "authority_uri": {
              "type": "string",
              "pattern": "^https://"
            },
            "succession": {
              "type": "object",
              "required": [
                "successor",
                "transfers",
                "invariant",
                "status"
              ]
            },
            "fallback_endpoint": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "not_accepted",
                    "accepted"
                  ]
                }
              }
            },
            "catalog_pinning": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "not_implemented",
                    "implemented"
                  ]
                }
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "textgroups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/textgroup"
          },
          {
            "properties": {
              "id": {
                "const": "pali"
              }
            }
          }
        ]
      }
    },
    "works": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      },
      "minItems": 1
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/version"
      }
    },
    "exemplars": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exemplar"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "description": {
            "type": "string"
          },
          "record_kind": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "iso_639_3": {
            "type": "string",
            "pattern": "^[a-z]{3}$"
          },
          "language": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "translators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "name": {
            "type": "string"
          },
          "record_kind": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "citation_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "applies_to",
          "status",
          "review_status",
          "node_identity_policy"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/token"
            }
          },
          "pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "examples": {
            "type": "array"
          },
          "status": {
            "type": "string"
          },
          "review_status": {
            "enum": [
              "imported_unreviewed",
              "under_review",
              "reviewed"
            ]
          },
          "node_identity_policy": {
            "enum": [
              "unspecified",
              "hierarchical_ordinal",
              "opaque_ids"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "classification_schemes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "multi_valued",
          "closed_vocabulary",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "label": {
            "type": "string"
          },
          "multi_valued": {
            "type": "boolean"
          },
          "closed_vocabulary": {
            "type": "boolean"
          },
          "values": {
            "type": "array"
          },
          "scope_rule": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "relationship_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "directional",
          "meaning"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "directional": {
            "type": "boolean"
          },
          "meaning": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "alignment_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alignmentSet"
      }
    },
    "witness_locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/witnessLocation"
      }
    },
    "identifier_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "urn",
          "status"
        ],
        "properties": {
          "urn": {
            "type": "string",
            "pattern": "^urn:cts:plicanon:"
          },
          "work_id": {
            "oneOf": [
              {
                "$ref": "#/$defs/token"
              },
              {
                "type": "null"
              }
            ]
          },
          "version_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "exemplar_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "legacy_migration": {
      "type": "object"
    },
    "urn_syntax": {
      "type": "object",
      "required": [
        "prefix",
        "work_component",
        "profile_token_pattern",
        "lexical_envelope_regex",
        "passage_delimiter",
        "notes"
      ],
      "properties": {
        "prefix": {
          "const": "urn:cts:plicanon:"
        },
        "work_component": {
          "type": "string"
        },
        "profile_token_pattern": {
          "type": "string"
        },
        "lexical_envelope_regex": {
          "type": "string"
        },
        "passage_delimiter": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "identity_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identityDecision"
      }
    },
    "legacy_aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legacyAlias"
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "textgroup": {
      "type": "object",
      "required": [
        "id",
        "purpose",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "label": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "work": {
      "type": "object",
      "required": [
        "id",
        "preferred_title",
        "classification_assertions",
        "legacy_assertions",
        "relationships",
        "review_status",
        "provenance",
        "citation_model_status",
        "minting_state",
        "aggregate_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "preferred_title": {
          "type": "string"
        },
        "title_language": {
          "type": [
            "string",
            "null"
          ]
        },
        "legacy_scholarly_abbreviation": {
          "type": [
            "string",
            "null"
          ]
        },
        "citation_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "classification_assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "legacy_assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "review_status": {
          "type": "string"
        },
        "provenance": {
          "type": "object"
        },
        "citation_model_status": {
          "enum": [
            "defined",
            "not_yet_defined",
            "not_recorded"
          ]
        },
        "minting_state": {
          "enum": [
            "blocked",
            "candidate",
            "held_uncertain",
            "approved_for_minting",
            "minted"
          ]
        },
        "aggregate_status": {
          "enum": [
            "not_assessed",
            "not_aggregate",
            "aggregate"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "citation_model_status": {
                "const": "defined"
              }
            },
            "required": [
              "citation_model_status"
            ]
          },
          "then": {
            "properties": {
              "citation_model_id": {
                "type": "string"
              }
            },
            "required": [
              "citation_model_id"
            ]
          },
          "else": {
            "properties": {
              "citation_model_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "required": [
        "scheme_id",
        "value",
        "status"
      ],
      "properties": {
        "scheme_id": {
          "$ref": "#/$defs/token"
        },
        "value": {
          "type": "string"
        },
        "scope": {
          "type": [
            "object",
            "null"
          ]
        },
        "asserted_by": {
          "type": "string"
        },
        "evidence": {
          "type": "array"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": [
        "type",
        "target_work_id",
        "status"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/token"
        },
        "target_work_id": {
          "$ref": "#/$defs/token"
        },
        "evidence": {
          "type": "array"
        },
        "asserted_by": {
          "type": "string"
        },
        "status": {
          "enum": [
            "unreviewed",
            "under_review",
            "reviewed"
          ]
        }
      },
      "additionalProperties": true
    },
    "collection": {
      "type": "object",
      "required": [
        "id",
        "label",
        "members",
        "review_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "label": {
          "type": "string"
        },
        "tradition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_collection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "work_id",
              "membership_value",
              "status"
            ],
            "properties": {
              "work_id": {
                "$ref": "#/$defs/token"
              },
              "membership_value": {
                "type": "string"
              },
              "evidence": {
                "type": "array"
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "review_status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "alignmentSet": {
      "type": "object",
      "required": [
        "id",
        "work_id",
        "mappings",
        "review_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "work_id": {
          "$ref": "#/$defs/token"
        },
        "shared_reference_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "shared_ref",
              "version_id",
              "relation",
              "status"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/token"
              },
              "shared_ref": {
                "type": "string"
              },
              "version_id": {
                "$ref": "#/$defs/token"
              },
              "exemplar_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "local_reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "local_spans": {
                "type": "array"
              },
              "relation": {
                "enum": [
                  "exact",
                  "contains",
                  "contained_by",
                  "overlaps",
                  "partial",
                  "unmatched",
                  "uncertain"
                ]
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provenance": {
                "type": "array"
              },
              "status": {
                "type": "string"
              },
              "group_id": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/token"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "review_status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "witnessLocation": {
      "type": "object",
      "required": [
        "id",
        "work_id",
        "version_id",
        "coordinate_system",
        "coordinate",
        "review_status",
        "index_origin"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "work_id": {
          "$ref": "#/$defs/token"
        },
        "version_id": {
          "$ref": "#/$defs/token"
        },
        "exemplar_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "coordinate_system": {
          "type": "string"
        },
        "coordinate": {
          "type": "object"
        },
        "shared_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_status": {
          "type": "string"
        },
        "index_origin": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "additionalProperties": true
    },
    "version": {
      "type": "object",
      "required": [
        "id",
        "work_id",
        "version_type",
        "review_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token",
          "pattern": "^v[0-9]{4,}$"
        },
        "work_id": {
          "$ref": "#/$defs/token"
        },
        "version_type": {
          "enum": [
            "edition",
            "translation",
            "transcription",
            "other"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "script": {
          "type": [
            "string",
            "null"
          ]
        },
        "editor_ids": {
          "type": "array"
        },
        "translator_ids": {
          "type": "array"
        },
        "publication": {
          "type": [
            "object",
            "null"
          ]
        },
        "source_artifact": {
          "type": [
            "object",
            "null"
          ]
        },
        "citation_model_mapping": {
          "type": [
            "object",
            "null"
          ]
        },
        "review_status": {
          "type": "string"
        },
        "artifact_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "revision_id",
              "status"
            ],
            "properties": {
              "revision_id": {
                "$ref": "#/$defs/token"
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "available",
                  "missing",
                  "superseded"
                ]
              },
              "supersedes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "change_class": {
                "enum": [
                  "rehost_identical",
                  "transcription_correction",
                  "editorial_change"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "shared_model_test": {
          "$ref": "#/$defs/sharedModelTest"
        }
      },
      "additionalProperties": true
    },
    "exemplar": {
      "type": "object",
      "required": [
        "id",
        "work_id",
        "version_id",
        "item_type",
        "review_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token",
          "pattern": "^x[0-9]{4,}$"
        },
        "work_id": {
          "$ref": "#/$defs/token"
        },
        "version_id": {
          "$ref": "#/$defs/token",
          "pattern": "^v[0-9]{4,}$"
        },
        "item_type": {
          "type": "string"
        },
        "review_status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "identityDecision": {
      "type": "object",
      "required": [
        "id",
        "subject_work_ids",
        "question",
        "outcome",
        "rationale",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "subject_work_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "subject_version_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "question": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "no_split",
            "new_version",
            "separate_work",
            "held_uncertain",
            "compilation_recorded"
          ]
        },
        "shared_model_test": {
          "$ref": "#/$defs/sharedModelTest"
        },
        "relation_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "subject_work_id",
              "type",
              "target_work_id"
            ],
            "properties": {
              "subject_work_id": {
                "$ref": "#/$defs/token"
              },
              "type": {
                "$ref": "#/$defs/token"
              },
              "target_work_id": {
                "$ref": "#/$defs/token"
              }
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "status": {
          "enum": [
            "draft",
            "under_review",
            "approved",
            "superseded",
            "withdrawn"
          ]
        },
        "compilation": {
          "type": "object",
          "required": [
            "boundary_documentation",
            "node_inheritance_rule"
          ],
          "properties": {
            "component_description": {
              "type": "string"
            },
            "boundary_documentation": {
              "type": "string",
              "minLength": 20
            },
            "node_inheritance_rule": {
              "type": "string",
              "minLength": 20
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "separate_work"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "subject_work_ids": {
                "minItems": 2
              },
              "relation_refs": {
                "minItems": 1
              }
            },
            "required": [
              "relation_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "decided_on": {
                "type": "string"
              }
            },
            "required": [
              "reviewer",
              "decided_on"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "compilation_recorded"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "compilation"
            ]
          },
          "else": {
            "required": [
              "shared_model_test"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "legacyAlias": {
      "type": "object",
      "required": [
        "legacy_urn",
        "outcome",
        "rationale",
        "status"
      ],
      "properties": {
        "legacy_urn": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "mapped",
            "quarantined_ambiguous",
            "rejected"
          ]
        },
        "target_urn": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "decided_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "mapped"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "target_urn": {
                "type": "string"
              }
            },
            "required": [
              "target_urn"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "sharedModelTest": {
      "type": "object",
      "required": [
        "model_id",
        "node_states",
        "verdict"
      ],
      "properties": {
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_reviewed": {
          "type": "boolean"
        },
        "node_states": {
          "type": "object",
          "required": [
            "mapped",
            "partial",
            "unmatched",
            "uncertain",
            "not_evaluated"
          ],
          "properties": {
            "mapped": {
              "type": "integer",
              "minimum": 0
            },
            "partial": {
              "type": "integer",
              "minimum": 0
            },
            "unmatched": {
              "type": "integer",
              "minimum": 0
            },
            "uncertain": {
              "type": "integer",
              "minimum": 0
            },
            "not_evaluated": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "reviewer_finding": {
          "type": "object",
          "required": [
            "structural_irreconcilable",
            "evidence"
          ],
          "properties": {
            "structural_irreconcilable": {
              "type": "boolean"
            },
            "evidence": {
              "type": "array"
            }
          }
        },
        "distinct_referential_scope": {
          "type": "object",
          "required": [
            "asserted",
            "documentation"
          ],
          "properties": {
            "asserted": {
              "type": "boolean"
            },
            "documentation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "verdict": {
          "enum": [
            "yes",
            "no",
            "uncertain"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}