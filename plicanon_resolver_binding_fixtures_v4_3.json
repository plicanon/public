{
  "note": "Synthetic cases for the resolver binding proposal (R1 to R5). Locators use the reserved example.invalid domain. History is ordered oldest to newest. 'observed' maps a location id to the digest of the bytes it returned, or null if it did not answer.",
  "cases": [
    {"id": "bind_01", "label": "Single primary location, bytes verify",
     "history": [{"revision_id": "r1", "status": "available", "digest": "d1"}],
     "locations": [{"id": "l1", "artifact_revision_id": "r1", "tier": "primary", "status": "active"}],
     "pinned": null, "observed": {"l1": "d1"}, "expected": ["serve", "r1", "primary"]},
    {"id": "bind_02", "label": "Primary down, mirror verifies",
     "history": [{"revision_id": "r1", "status": "available", "digest": "d1"}],
     "locations": [{"id": "l1", "artifact_revision_id": "r1", "tier": "primary", "status": "active"}, {"id": "l2", "artifact_revision_id": "r1", "tier": "mirror", "status": "active"}],
     "pinned": null, "observed": {"l1": null, "l2": "d1"}, "expected": ["serve", "r1", "mirror"]},
    {"id": "bind_03", "label": "Primary returns wrong bytes, mirror verifies",
     "history": [{"revision_id": "r1", "status": "available", "digest": "d1"}],
     "locations": [{"id": "l1", "artifact_revision_id": "r1", "tier": "primary", "status": "active"}, {"id": "l2", "artifact_revision_id": "r1", "tier": "mirror", "status": "active"}],
     "pinned": null, "observed": {"l1": "bad", "l2": "d1"}, "expected": ["serve", "r1", "mirror"]},
    {"id": "bind_04", "label": "No location answers",
     "history": [{"revision_id": "r1", "status": "available", "digest": "d1"}],
     "locations": [{"id": "l1", "artifact_revision_id": "r1", "tier": "primary", "status": "active"}, {"id": "l2", "artifact_revision_id": "r1", "tier": "mirror", "status": "active"}],
     "pinned": null, "observed": {"l1": null, "l2": null}, "expected": ["content_unavailable", null, null]},
    {"id": "bind_05", "label": "Every location returns wrong bytes",
     "history": [{"revision_id": "r1", "status": "available", "digest": "d1"}],
     "locations": [{"id": "l1", "artifact_revision_id": "r1", "tier": "primary", "status": "active"}, {"id": "l2", "artifact_revision_id": "r1", "tier": "mirror", "status": "active"}],
     "pinned": null, "observed": {"l1": "bad", "l2": "bad2"}, "expected": ["integrity_failure", null, null]},
    {"id": "bind_06", "label": "Default request serves the latest available revision, not the superseded one",
     "history": [{"revision_id": "r1", "status": "superseded", "digest": "d1"}, {"revision_id": "r2", "status": "available", "digest": "d2"}],
     "locations": [{"id": "l1", "artifact_revision_id": "r1", "tier": "primary", "status": "active"}, {"id": "l2", "artifact_revision_id": "r2", "tier": "primary", "status": "active"}],
     "pinned": null, "observed": {"l1": "d1", "l2": "d2"}, "expected": ["serve", "r2", "primary"]},
    {"id": "bind_07", "label": "Pinned superseded revision is served",
     "history": [{"revision_id": "r1", "status": "superseded", "digest": "d1"}, {"revision_id": "r2", "status": "available", "digest": "d2"}],
     "locations": [{"id": "l1", "artifact_revision_id": "r1", "tier": "primary", "status": "active"}, {"id": "l2", "artifact_revision_id": "r2", "tier": "primary", "status": "active"}],
     "pinned": "r1", "observed": {"l1": "d1", "l2": "d2"}, "expected": ["serve", "r1", "primary"]},
    {"id": "bind_08", "label": "Latest revision missing: default must not fall back to the superseded one",
     "history": [{"revision_id": "r1", "status": "superseded", "digest": "d1"}, {"revision_id": "r2", "status": "missing", "digest": "d2"}],
     "locations": [{"id": "l1", "artifact_revision_id": "r1", "tier": "primary", "status": "active"}],
     "pinned": null, "observed": {"l1": "d1"}, "expected": ["content_unavailable", null, null]},
    {"id": "bind_09", "label": "Version with no artifact",
     "history": [], "locations": [], "pinned": null, "observed": {}, "expected": ["no_artifact", null, null]},
    {"id": "bind_10", "label": "Archive tier used only when primary and mirror fail",
     "history": [{"revision_id": "r1", "status": "available", "digest": "d1"}],
     "locations": [{"id": "l1", "artifact_revision_id": "r1", "tier": "archive", "status": "active"}, {"id": "l2", "artifact_revision_id": "r1", "tier": "primary", "status": "active"}, {"id": "l3", "artifact_revision_id": "r1", "tier": "mirror", "status": "active"}],
     "pinned": null, "observed": {"l1": "d1", "l2": null, "l3": null}, "expected": ["serve", "r1", "archive"]}
  ]
}
